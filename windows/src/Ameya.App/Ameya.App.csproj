<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray-first WinUI 3 app, packaged as MSIX. It never parses file contents itself beyond the
       first bytes for detection: every conversion runs in a sandboxed Ameya.Worker process. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AmeyaWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Ameya.App</RootNamespace>
    <AssemblyName>Ameya.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Ameya.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs has its own Main, so --self-test runs before any XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <SelfContained Condition="'$(AmeyaSelfContained)' == 'true'">true</SelfContained>
    <!-- CI signs the package with a throwaway certificate; no key is ever committed. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\packages\</AppxPackageDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Ameya.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT. Pinned. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ameya.Core\Ameya.Core.csproj" />
    <ProjectReference Include="..\Ameya.Engines\Ameya.Engines.csproj" />
    <!-- Copies Ameya.Worker.exe next to the app (and into the MSIX). -->
    <ProjectReference Include="..\Ameya.Worker\Ameya.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>
